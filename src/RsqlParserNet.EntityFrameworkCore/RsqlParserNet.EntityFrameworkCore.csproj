<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RsqlParserNet.Linq\RsqlParserNet.Linq.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>RsqlParserNet.EntityFrameworkCore</PackageId>
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Title>RsqlParserNet.EntityFrameworkCore</Title>
    <Description>Entity Framework Core async execution helpers for RsqlParserNet LINQ queries.</Description>
    <PackageTags>rsql;fiql;entity-framework-core;efcore;linq;query;filtering;pagination</PackageTags>
    <PackageProjectUrl>https://github.com/ai-iskuzhin/RsqlParserNet</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>ai-iskuzhin</Authors>
    <Company>ai-iskuzhin</Company>
    <Product>RsqlParserNet</Product>
    <Copyright>Copyright (c) ai-iskuzhin</Copyright>
    <RepositoryUrl>https://github.com/ai-iskuzhin/RsqlParserNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageReleaseNotes>First stable release of the Entity Framework Core adapter with async paged result helpers for allowlisted RSQL LINQ queries, filtering, and multi-field sorting.</PackageReleaseNotes>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

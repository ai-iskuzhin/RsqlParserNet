<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <ProjectReference Include="..\RsqlParserNet.OpenApi\RsqlParserNet.OpenApi.csproj" />
    <PackageReference Include="NSwag.Generation.AspNetCore" Version="14.7.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>RsqlParserNet.NSwag</PackageId>
    <Version>1.1.0</Version>
    <PackageVersion>1.1.0</PackageVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <Title>RsqlParserNet.NSwag</Title>
    <Description>NSwag operation processor helpers for documenting RsqlParserNet query parameters.</Description>
    <PackageTags>rsql;fiql;nswag;swagger;openapi;aspnetcore;query;filtering;documentation</PackageTags>
    <PackageProjectUrl>https://github.com/ai-iskuzhin/RsqlParserNet</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>ai-iskuzhin</Authors>
    <Company>ai-iskuzhin</Company>
    <Product>RsqlParserNet</Product>
    <Copyright>Copyright (c) ai-iskuzhin</Copyright>
    <RepositoryUrl>https://github.com/ai-iskuzhin/RsqlParserNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageReleaseNotes>Minor release updating the transitive Microsoft.OpenApi dependency to 2.7.5 to address CVE-2026-49451 (GHSA-v5pm-xwqc-g5wc).</PackageReleaseNotes>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
